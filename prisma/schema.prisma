generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String               @id
  sku          String               @unique
  brand        String?
  category     String
  imageUrl     String?
  price        Decimal?             @db.Decimal(12, 2)
  currency     String?
  stock        Int?
  syncedAt     DateTime
  translations ProductTranslation[]
  inquiries    Inquiry[]

  @@index([category])
  @@index([syncedAt])
}

model ProductTranslation {
  id          Int     @id @default(autoincrement())
  productId   String
  lang        Lang
  name        String
  description String?
  product     Product @relation(fields: [productId], references: [id])

  @@unique([productId, lang])
}

model Inquiry {
  id            Int           @id @default(autoincrement())
  productId     String
  name          String
  phone         String
  message       String?
  status        InquiryStatus @default(NEW)
  assignedTo    Int?
  submittedById Int?
  createdAt     DateTime      @default(now())
  product       Product       @relation(fields: [productId], references: [id])
  submittedBy   User?         @relation("SubmittedInquiries", fields: [submittedById], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([productId])
}

model Setting {
  key   String  @id
  value Boolean
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  password           String
  name               String?
  role               Role      @default(SALES)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  submittedInquiries Inquiry[] @relation("SubmittedInquiries")
}

enum Lang {
  AZ
  EN
  RU
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  DONE
}

enum Role {
  ADMIN
  SALES
}

model Banner {
  id         Int      @id @default(autoincrement())
  titleAZ    String
  titleEN    String
  titleRU    String
  subtitleAZ String?
  subtitleEN String?
  subtitleRU String?
  descAZ     String?
  descEN     String?
  descRU     String?
  ctaText    String?
  ctaUrl     String?
  ctaText2   String?
  ctaUrl2    String?
  imageUrl   String?
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Partner {
  id         Int      @id @default(autoincrement())
  name       String
  logoUrl    String?
  websiteUrl String?
  descAZ     String?
  descEN     String?
  descRU     String?
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model News {
  id           Int               @id @default(autoincrement())
  slug         String            @unique
  imageUrl     String?
  authorName   String            @default("Cyberspace Team")
  publishedAt  DateTime?
  status       NewsStatus        @default(DRAFT)
  order        Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  translations NewsTranslation[]

  @@index([status])
  @@index([publishedAt])
}

model NewsTranslation {
  id      Int    @id @default(autoincrement())
  newsId  Int
  lang    Lang
  title   String
  excerpt String
  body    String @db.Text
  news    News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, lang])
}

model Category {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nameAZ    String
  nameEN    String
  nameRU    String
  imageUrl  String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

model CareerPage {
  id               Int      @id @default(1)
  heroTitleAZ      String?
  heroTitleEN      String?
  heroTitleRU      String?
  heroDescAZ       String?  @db.Text
  heroDescEN       String?  @db.Text
  heroDescRU       String?  @db.Text
  heroImageUrl     String?
  heroCta1AZ       String?
  heroCta1EN       String?
  heroCta1RU       String?
  heroCta2AZ       String?
  heroCta2EN       String?
  heroCta2RU       String?
  introHeadingAZ   String?
  introHeadingEN   String?
  introHeadingRU   String?
  introBodyAZ      String?  @db.Text
  introBodyEN      String?  @db.Text
  introBodyRU      String?  @db.Text
  introImageUrl    String?
  missionAZ        String?  @db.Text
  missionEN        String?  @db.Text
  missionRU        String?  @db.Text
  visionAZ         String?  @db.Text
  visionEN         String?  @db.Text
  visionRU         String?  @db.Text
  cultureHeadingAZ String?
  cultureHeadingEN String?
  cultureHeadingRU String?
  cultureBodyAZ    String?  @db.Text
  cultureBodyEN    String?  @db.Text
  cultureBodyRU    String?  @db.Text
  seoTitleAZ       String?
  seoTitleEN       String?
  seoTitleRU       String?
  seoDescAZ        String?  @db.Text
  seoDescEN        String?  @db.Text
  seoDescRU        String?  @db.Text
  isPublished      Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

model CareerBenefit {
  id        Int      @id @default(autoincrement())
  icon      String?
  imageUrl  String?
  titleAZ   String
  titleEN   String
  titleRU   String
  descAZ    String?  @db.Text
  descEN    String?  @db.Text
  descRU    String?  @db.Text
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

model CareerExpertise {
  id        Int      @id @default(autoincrement())
  icon      String?
  titleAZ   String
  titleEN   String
  titleRU   String
  descAZ    String?  @db.Text
  descEN    String?  @db.Text
  descRU    String?  @db.Text
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

model CareerGalleryImage {
  id        Int      @id @default(autoincrement())
  imageUrl  String
  captionAZ String?
  captionEN String?
  captionRU String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([isActive])
  @@index([order])
}

model CareerOpportunity {
  id         Int      @id @default(autoincrement())
  titleAZ    String
  titleEN    String
  titleRU    String
  department String?
  location   String?
  typeAZ     String?
  typeEN     String?
  typeRU     String?
  descAZ     String?  @db.Text
  descEN     String?  @db.Text
  descRU     String?  @db.Text
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

model CareerApplication {
  id              Int                     @id @default(autoincrement())
  fullName        String
  email           String
  phone           String
  positionApplied String
  country         String?
  linkedinUrl     String?
  portfolioUrl    String?
  yearsExperience Int?
  coverLetter     String?                 @db.Text
  resumePath      String
  resumeFileName  String
  status          CareerApplicationStatus @default(NEW)
  createdAt       DateTime                @default(now())

  @@index([status])
  @@index([createdAt])
  @@index([email])
}

enum CareerApplicationStatus {
  NEW
  REVIEWED
  SHORTLISTED
  REJECTED
}

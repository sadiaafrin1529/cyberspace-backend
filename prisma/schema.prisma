generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           String               @id
  sku          String               @unique
  brand        String?
  category     String
  imageUrl     String?
  price        Decimal?             @db.Decimal(12, 2)
  currency     String?
  stock        Int?
  syncedAt     DateTime
  translations ProductTranslation[]
  inquiries    Inquiry[]

  @@index([category])
  @@index([syncedAt])
}

model ProductTranslation {
  id          Int     @id @default(autoincrement())
  productId   String
  lang        Lang
  name        String
  description String?
  product     Product @relation(fields: [productId], references: [id])

  @@unique([productId, lang])
}

model Inquiry {
  id            Int           @id @default(autoincrement())
  productId     String
  name          String
  phone         String
  message       String?
  status        InquiryStatus @default(NEW)
  assignedTo    Int?
  submittedById Int?
  createdAt     DateTime      @default(now())
  product       Product       @relation(fields: [productId], references: [id])
  submittedBy   User?         @relation("SubmittedInquiries", fields: [submittedById], references: [id])

  @@index([status])
  @@index([createdAt])
  @@index([productId])
}

model Setting {
  key   String  @id
  value Boolean
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique
  password           String
  name               String?
  role               Role      @default(SALES)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  submittedInquiries Inquiry[] @relation("SubmittedInquiries")
}

enum Lang {
  AZ
  EN
  RU
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  DONE
}

enum Role {
  ADMIN
  SALES
}

model Banner {
  id         Int      @id @default(autoincrement())
  titleAZ    String
  titleEN    String
  titleRU    String
  subtitleAZ String?
  subtitleEN String?
  subtitleRU String?
  descAZ     String?
  descEN     String?
  descRU     String?
  ctaText    String?
  ctaUrl     String?
  ctaText2   String?
  ctaUrl2    String?
  imageUrl   String?
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Partner {
  id         Int      @id @default(autoincrement())
  name       String
  logoUrl    String?
  websiteUrl String?
  descAZ     String?
  descEN     String?
  descRU     String?
  categoryAZ String?
  categoryEN String?
  categoryRU String?
  suppliesAZ String?
  suppliesEN String?
  suppliesRU String?
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model News {
  id           Int               @id @default(autoincrement())
  slug         String            @unique
  imageUrl     String?
  authorName   String            @default("Cyberspace Team")
  publishedAt  DateTime?
  status       NewsStatus        @default(DRAFT)
  order        Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  translations NewsTranslation[]

  @@index([status])
  @@index([publishedAt])
}

model NewsTranslation {
  id      Int    @id @default(autoincrement())
  newsId  Int
  lang    Lang
  title   String
  excerpt String
  body    String @db.Text
  news    News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, lang])
}

model Category {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nameAZ    String
  nameEN    String
  nameRU    String
  imageUrl  String?
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

enum NewsStatus {
  DRAFT
  PUBLISHED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkplaceType {
  ON_SITE
  REMOTE
  HYBRID
}

enum JobStatus {
  DRAFT
  PUBLISHED
  EXPIRED
}

enum JobApplicationStatus {
  PENDING
  REVIEWING
  SHORTLISTED
  INTERVIEW
  ACCEPTED
  REJECTED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model Job {
  id             Int              @id @default(autoincrement())
  slug           String           @unique
  department     String
  employmentType EmploymentType
  workplaceType  WorkplaceType
  location       String
  vacancies      Int              @default(1)
  salaryRange    String?
  postedAt       DateTime         @default(now())
  expiresAt      DateTime
  status         JobStatus        @default(DRAFT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  translations   JobTranslation[]
  applications   JobApplication[]

  @@index([status])
  @@index([expiresAt])
  @@index([postedAt])
}

model JobTranslation {
  id                    Int      @id @default(autoincrement())
  jobId                 Int
  lang                  Lang
  title                 String
  shortDescription      String?
  description           String   @db.Text
  responsibilities      String?  @db.Text
  requirements          String   @db.Text
  requiredSkills        String[]
  experienceLevel       String?
  educationRequirements String?  @db.Text
  job                   Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, lang])
}

model JobApplication {
  id             Int                  @id @default(autoincrement())
  jobId          Int
  job            Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fullName       String
  email          String
  phone          String
  cvFilePath     String
  cvOriginalName String
  cvMimeType     String
  cvSize         Int
  message        String?              @db.Text
  status         JobApplicationStatus @default(PENDING)
  emailStatus    EmailStatus          @default(PENDING)
  emailError     String?
  emailAttempts  Int                  @default(0)
  appliedAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([jobId, email])
  @@index([jobId])
  @@index([status])
  @@index([email])
  @@index([appliedAt])
}

model Solution {
  id           Int                   @id @default(autoincrement())
  slug         String                @unique
  color        String                @default("blue")
  iconKey      String?
  iconUrl      String?
  imageUrl     String?
  bannerUrl    String?
  images       String[]
  isActive     Boolean               @default(true)
  order        Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  translations SolutionTranslation[]

  @@index([isActive])
  @@index([order])
}

model SolutionTranslation {
  id               Int      @id @default(autoincrement())
  solutionId       Int
  lang             Lang
  title            String
  shortDescription String
  description      String?  @db.Text
  features         String[]
  seoTitle         String?
  seoDescription   String?
  solution         Solution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@unique([solutionId, lang])
}

model ProjectCategory {
  id           Int                          @id @default(autoincrement())
  slug         String                       @unique
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  translations ProjectCategoryTranslation[]
  projects     Project[]
}

model ProjectCategoryTranslation {
  id         Int             @id @default(autoincrement())
  categoryId Int
  lang       Lang
  name       String
  category   ProjectCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, lang])
}

model Project {
  id           Int                  @id @default(autoincrement())
  slug         String               @unique
  coverImage   String
  images       String[]
  categoryId   Int
  category     ProjectCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  translations ProjectTranslation[]

  @@index([categoryId])
  @@index([createdAt])
}

model ProjectTranslation {
  id               Int     @id @default(autoincrement())
  projectId        Int
  lang             Lang
  title            String
  shortDescription String?
  description      String? @db.Text
  project          Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, lang])
}
